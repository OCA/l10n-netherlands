<odoo>
    <record id="view_users_form" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="partner_firstname.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='firstname']" position="after">
                <field name="initials" placeholder="Initials" />
            </xpath>
            <xpath
                expr="//field[@name='lastname' and @invisible='form_has_lastname_first']"
                position="before"
            >
                <field name="infix" placeholder="Infix" />
            </xpath>
        </field>
    </record>
</odoo>
