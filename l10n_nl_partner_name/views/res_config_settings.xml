<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="partner_firstname.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//setting/field[@name='partner_names_order']/.."
                position="attributes"
            >
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath
                expr="//setting/field[@name='partner_names_required_fields']/.."
                position="after"
            >
                <setting>
                    <field name="l10n_nl_partner_name_infixes" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
