<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='tax_exigibility']" position="attributes">
                <attribute name="invisible">l10n_nl_tax_invoice_basis</attribute>
            </xpath>
            <setting id="eu_service" position="after">
                <setting
                    help="If this checkbox is ticked, you will enable the Netherlands Tax Invoice Basis (Factuurstelsel)."
                    company_dependent="1"
                >
                    <field name="l10n_nl_tax_invoice_basis" />
                </setting>
                <setting
                    help="Journal and account used to post the entry that balances the NL VAT statement. Optionally, you can also configure a partner to link to the payable/receivable amount."
                    string="NL Tax Statement Posting"
                    company_dependent="1"
                >
                    <div class="content-group">
                        <div class="row mt8">
                            <label
                                for="l10n_nl_tax_statement_journal_id"
                                class="col-lg-4 o_light_label"
                                string="Journal"
                            />
                            <field
                                name="l10n_nl_tax_statement_journal_id"
                                options="{'no_create': True}"
                            />
                        </div>
                        <div class="row mt8">
                            <label
                                for="l10n_nl_tax_statement_rounding_account_id"
                                string="Rounding Account"
                                class="col-lg-4 o_light_label"
                            />
                            <field
                                name="l10n_nl_tax_statement_rounding_account_id"
                                options="{'no_create': True}"
                            />
                        </div>
                        <div class="row mt8">
                            <label
                                for="l10n_nl_tax_statement_partner_id"
                                string="Tax Autority Partner"
                                class="col-lg-4 o_light_label"
                            />
                            <field
                                name="l10n_nl_tax_statement_partner_id"
                                options="{'no_create': True}"
                            />
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
