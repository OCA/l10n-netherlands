<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="eu_service" position="after">
                <div
                    class="col-xs-12 col-md-6 o_setting_box"
                    title="If this checkbox is ticked, you will enable the Netherlands Tax Invoice Basis (Factuurstelsel)."
                >
                    <div class="o_setting_left_pane">
                        <field name="l10n_nl_tax_invoice_basis" />
                    </div>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">NL Tax Invoice Basis</span>
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            aria-label="Values set here are company-specific."
                            groups="base.group_multi_company"
                        />
                        <div class="text-muted">
                           NL Tax Invoice Basis (Factuurstelsel)
                        </div>
                    </div>
                </div>
                <div
                    class="col-xs-12 col-md-6 o_setting_box"
                    title="Journal and account used to post the entry that balances the NL VAT statement."
                >
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">NL Tax Statement Posting</span>
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            aria-label="Values set here are company-specific."
                            groups="base.group_multi_company"
                        />
                        <div class="text-muted">
                            Journal and rounding account used to post the NL VAT statement journal entry.
                            Optionally, you can also configure a partner to link to the payable/receivable
                            amount.
                        </div>
                        <div class="content-group mt16">
                            <div class="row">
                                <label
                                    for="l10n_nl_tax_statement_journal_id"
                                    string="Journal"
                                    class="col-lg-4 o_light_label"
                                />
                                <field
                                    name="l10n_nl_tax_statement_journal_id"
                                    domain="[('type', '=', 'general'), ('company_id', '=', company_id)]"
                                    options="{'no_create': True}"
                                />
                            </div>
                            <div class="row">
                                <label
                                    for="l10n_nl_tax_statement_rounding_account_id"
                                    string="Rounding Account"
                                    class="col-lg-4 o_light_label"
                                />
                                <field
                                    name="l10n_nl_tax_statement_rounding_account_id"
                                    domain="[('company_id', '=', company_id)]"
                                    options="{'no_create': True}"
                                />
                            </div>
                            <div class="row">
                                <label
                                    for="l10n_nl_tax_statement_partner_id"
                                    string="Tax Authority Partner"
                                    class="col-lg-4 o_light_label"
                                />
                                <field
                                    name="l10n_nl_tax_statement_partner_id"
                                    options="{'no_create': True}"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <xpath expr="//div[@id='tax_exigibility']" position="attributes">
                <attribute name="attrs">
                    {
                        'invisible': [('l10n_nl_tax_invoice_basis', '=', True)]
                    }
                </attribute>
            </xpath>
        </field>
    </record>

</odoo>
