<odoo>
    <record model="ir.ui.view" id="liza_search_wizard_line_form_view">
        <field name="model">liza.search.wizard.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name" />
                        <field name="registry" />
                        <field name="is_active" />
                    </group>
                    <group>
                        <field name="street" />
                        <field name="city" />
                        <field name="country" />
                    </group>
                </group>
                <footer>
                    <button
                        string="Select &amp; Fill"
                        type="object"
                        name="select"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="liza_search_wizard_line_list_view">
        <field name="model">liza.search.wizard.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name" />
                <field name="street" />
                <field name="city" />
                <field name="country" />
                <field name="registry" />
                <field name="is_active" />
                <button
                    type="object"
                    name="select"
                    string="Select &amp; Fill"
                    class="oe_highlight"
                />
            </list>
        </field>
    </record>
</odoo>
