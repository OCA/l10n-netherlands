<odoo>
    <record model="ir.ui.view" id="liza_search_wizard_form_view">
        <field name="model">liza.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Search Liza">
                <group>
                    <field name="partner_id" invisible="True" />
                    <group>
                        <field name="search_term" />
                        <field name="zip" />
                        <field name="city" />
                        <field name="country_code" />
                    </group>
                    <group>
                        <field name="vat" />
                        <field name="company_registry" />
                    </group>
                    <group>
                        <button
                            type="object"
                            name="liza_search"
                            string="Search"
                            class="oe_highlight"
                            invisible="not display_search_button"
                        />
                    </group>
                </group>
                <notebook>
                    <page string="Search Results">
                        <field name="line_ids" />
                    </page>
                </notebook>
                <footer>
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="liza_search_wizard_act_window">
        <field name="name">Liza Search Wizard</field>
        <field name="res_model">liza.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
