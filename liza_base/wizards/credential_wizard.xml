<odoo>
    <record id="liza_credential_wizard" model="ir.ui.view">
        <field name="name">Liza Credential Wizard</field>
        <field name="model">liza_base.credential_wizard_abstract</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="liza_login" required="1" />
                </group>
                <group>
                    <field name="liza_password" required="1" password="True" />
                </group>

                <br />
                <span>Click here to create your login information: </span>
                <a
                    href="https://www.liza.nl"
                    title="Follow this link"
                    target="_blank"
                >https://www.liza.nl</a>
                <footer>
                    <button
                        type="object"
                        name="save_liza_login_pwd"
                        string="Save"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
