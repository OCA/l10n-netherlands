<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_liza_send_open_invoices" model="ir.cron">
        <field name="name">Liza: Send Open Invoices</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="code">model._cron_liza_send_open_invoices()</field>
        <field
            name="nextcall"
            eval="(DateTime.now().replace(hour=3,minute=DateTime.now().microsecond % 60).strftime('%Y-%m-%d %H:%M:%S'))"
        />
    </record>
</odoo>
